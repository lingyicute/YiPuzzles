<?xml version="1.0" encoding="utf-8"?>
<!--
  Help page: one FAQ entry as a Material 3 expandable card.

  The whole card is the toggle target: a clickable/focusable MaterialCardView
  draws the M3 state layer (ripple) on press, hover and focus by itself. The
  chevron rotates and the answer section expands with Material 3 motion (the
  duration/easing theme tokens are resolved in HelpQuestionAdapter). The
  expanded state is exposed to accessibility services via
  ViewCompat.setStateDescription.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewFilledStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
    app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Question: header row of the card (M3 list item metrics:
             56dp min height, 16dp start padding, 24dp icon) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/helpQuestion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="What is the goal of this game?" />

            <!-- Decorative: the expanded/collapsed state is announced through
                 the card's state description instead -->
            <ImageView
                android:id="@+id/expandIndicator"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

        <!-- Answer: the expandable section of the card. Its height is
             animated by HelpQuestionAdapter; keep it 'gone' by default. -->
        <LinearLayout
            android:id="@+id/helpAnswerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- M3 divider separating question and answer inside the card -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="?attr/colorOutlineVariant" />

            <TextView
                android:id="@+id/helpAnswer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="The goal of this game is to get the number 2048." />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
